---
import { Icon } from 'astro-icon/components'

interface Props {
  bib: string
}

const { bib } = Astro.props
---

<div class="card bg-base-200 shadow-md">
  <div class="bg-base-300 flex items-center justify-between px-4 py-2">
    <h2 class="text-base-content font-semibold">How to cite</h2>
    <button type="button" class="btn btn-ghost btn-sm cite-copy" aria-label="Copy citation">
      <Icon name="fa6-solid:copy" class="text-base" />
      <span>Copy</span>
    </button>
  </div>
  <p role="status" class="cite-status px-4 text-sm"></p>
  <pre class="cite-content overflow-x-auto p-4 text-xs break-words whitespace-pre-wrap">{bib}</pre>
</div>

<script>
  // One delegated listener handles every citation in this document.
  document.addEventListener('click', async (event) => {
    const target = event.target
    if (!(target instanceof Element)) return
    const btn = target.closest('.cite-copy')
    if (!(btn instanceof HTMLButtonElement)) return
    const card = btn.closest('.card')
    const citation = card?.querySelector('.cite-content')?.textContent
    const status = card?.querySelector('.cite-status')
    if (!citation || !status) return
    btn.disabled = true
    status.textContent = ''
    try {
      await navigator.clipboard.writeText(citation)
      status.textContent = 'Citation copied.'
    } catch {
      status.textContent = 'Copy failed. Select the citation below.'
    } finally {
      btn.disabled = false
    }
  })
</script>
