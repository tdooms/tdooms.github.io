---
// Regular pages share the home link and theme toggle; Atlas owns its navbar.
import Icon from './Icon.svelte'

interface Props {
  homeHref?: string
}

const { homeHref = '/' } = Astro.props
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === ''
---

<nav
  aria-label="Site"
  class="text-base-content/65 flex h-14 shrink-0 items-center justify-between px-3"
>
  {
    isHome ? (
      <span />
    ) : (
      <a href={homeHref} aria-label="Home" class="site-home btn btn-ghost btn-square btn-sm">
        <Icon name="house" class="h-4 w-4" />
      </a>
    )
  }
  <label class="btn btn-ghost btn-square btn-sm swap swap-rotate" aria-label="Toggle dark mode">
    <input type="checkbox" class="theme-controller" value="dark" />
    <Icon name="sun" class="swap-off h-4 w-4" />
    <Icon name="moon" class="swap-on h-4 w-4" />
  </label>
</nav>
