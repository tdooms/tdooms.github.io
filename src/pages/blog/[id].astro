---
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import EntryNav from '../../components/EntryNav.astro'
import { formatFullDate } from '../../lib/format'

export async function getStaticPaths() {
  const blogs = await getCollection('blogs')
  const local = blogs.filter((blog) => !blog.data.external)
  const sorted = local.slice().sort((a, b) => b.data.date.localeCompare(a.data.date))
  return local.map((blog) => {
    const idx = sorted.findIndex((b) => b.id === blog.id)
    const prev =
      idx > 0 ? { href: `/blog/${sorted[idx - 1]!.id}`, title: sorted[idx - 1]!.data.title } : null
    const next =
      idx < sorted.length - 1
        ? { href: `/blog/${sorted[idx + 1]!.id}`, title: sorted[idx + 1]!.data.title }
        : null
    return { params: { id: blog.id }, props: { blog, prev, next } }
  })
}

const { blog, prev, next } = Astro.props
const { Content } = await render(blog)

const formattedDate = formatFullDate(blog.data.date)
const homeHref = '/#blog'
---

<Layout title={blog.data.title} description={blog.data.description} {homeHref}>
  <div class="mx-auto max-w-3xl">
    <h1 class="mb-2 text-4xl font-bold">{blog.data.title}</h1>
    <div class="text-base-content/75 mb-6">{formattedDate}</div>

    <div
      class="prose prose-lg max-w-none overflow-x-auto [overflow-wrap:anywhere]"
      role="region"
      aria-label={`${blog.data.title} article`}
      tabindex="0"
    >
      <Content />
    </div>

    <EntryNav prev={prev} next={next} {homeHref} />
  </div>
</Layout>
