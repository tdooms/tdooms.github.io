{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    // No `baseUrl` (deprecated in TS 6) — `paths` resolve relative to this file.
    "paths": {
      "@/*": ["./src/*"],
      "$lib/*": ["./src/components/bae/lib/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
